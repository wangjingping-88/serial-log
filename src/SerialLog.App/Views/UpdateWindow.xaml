<Window x:Class="SerialLog.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial Log 更新"
        Icon="/SerialLog.App;component/Assets/AppIcon.ico"
        Width="660"
        Height="500"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#EEF2F6">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="发现 Serial Log 新版本"
                   FontSize="20"
                   FontWeight="Bold" />

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前版本" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Margin="10,0,24,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="最新版本" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="LatestVersionText" Grid.Column="3" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="更新说明" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="ReleaseNotesTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="8"
                         Margin="0"
                         VerticalContentAlignment="Top" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="InstallModeText"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="DownloadProgressBar"
                         Height="8"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed" />
            <TextBlock x:Name="ProgressText"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="打开发布页"
                    Style="{StaticResource CompactButton}"
                    Click="OpenReleasePageButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="稍后"
                    Style="{StaticResource CompactButton}"
                    MinWidth="72"
                    Click="CancelButton_Click" />
            <Button x:Name="InstallButton"
                    Grid.Column="3"
                    Content="下载并安装"
                    Style="{StaticResource CompactPrimaryButton}"
                    MinWidth="108"
                    Margin="8,0,0,0"
                    Click="InstallButton_Click" />
        </Grid>
    </Grid>
</Window>

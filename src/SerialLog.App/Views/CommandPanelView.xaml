<UserControl x:Class="SerialLog.App.Views.CommandPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="CommandPanelViewport" ClipToBounds="True">
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="PublicPanelRow">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                                <Setter Property="Height" Value="*" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition x:Name="CommandPanelRow">
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                                <Setter Property="Height" Value="*" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PublicPanelColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                                <Setter Property="Width" Value="*" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
            <ColumnDefinition x:Name="CommandPanelColumn">
                <ColumnDefinition.Style>
                    <Style TargetType="ColumnDefinition">
                        <Setter Property="Width" Value="2*" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                                <Setter Property="Width" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ColumnDefinition.Style>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TabControl x:Name="PublicPanel"
                    Grid.Row="0"
                    Grid.Column="0">
            <TabControl.Style>
                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                    <Setter Property="Margin" Value="0,0,5,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem x:Name="TargetWindowsTab" Header="目标窗口">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0"
                              Content="全选"
                              IsChecked="{Binding IsAllSingleCommandTargetsSelected, Mode=TwoWay}"
                              Margin="4,0,0,3">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandGroupTabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <CheckBox Grid.Row="0"
                              Content="全选"
                              IsChecked="{Binding IsAllCommandGroupTargetsSelected, Mode=TwoWay}"
                              Margin="4,0,0,3">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandGroupTabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandGroupTabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding SerialWindows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="92" ItemHeight="28" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedForSend}"
                                              Width="86"
                                              Margin="4,3,2,3"
                                              ToolTip="{Binding Title}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="IsEnabled" Value="{Binding CanSendCommands}" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRemote}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsYmodemTabSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                        <TextBlock Text="{Binding Title}"
                                                   Width="62"
                                                   TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommandGroupTabSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding SelectedCommandGroup.Targets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="92" ItemHeight="28" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Width="86"
                                              Margin="4,3,2,3"
                                              ToolTip="{Binding Title}">
                                        <TextBlock Text="{Binding Title}"
                                                   Width="62"
                                                   TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="HistoryTab" Header="历史记录">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" HorizontalAlignment="Right">
                        <Button Content="填单条"
                                Style="{StaticResource CompactButton}"
                                Command="{Binding FillSingleCommandFromHistoryCommand}"
                                ToolTip="把选中的历史命令填入单条命令编辑框" />
                        <Button Content="入组"
                                Style="{StaticResource CompactButton}"
                                Command="{Binding AddHistoryCommandToGroupCommand}"
                                ToolTip="把选中的历史命令填入命令组编辑框" />
                        <Button Content="清空历史"
                                Style="{StaticResource CompactButton}"
                                Command="{Binding ClearCommandHistoryCommand}"
                                ToolTip="最多保留 100 条发送历史" />
                    </WrapPanel>
                    <ListBox Grid.Row="1"
                             Margin="0,6,0,0"
                             ItemsSource="{Binding CommandHistory}"
                             SelectedItem="{Binding SelectedHistoryCommand, Mode=TwoWay}"
                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                             PreviewKeyDown="CommandHistoryListBox_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.RemoveCommandHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="ImportTab" Header="命令导入">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="68" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ImportedAtCommandSets}"
                                      SelectedItem="{Binding SelectedAtCommandSet}"
                                      MinWidth="120"
                                      Margin="0,0,6,0"
                                      ToolTip="当前导入命令集">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="1"
                                     InputMethod.IsInputMethodEnabled="True"
                                     Text="{Binding SelectedAtCommandSet.Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="命令集名称"
                                     MinWidth="80"
                                     Margin="0,0,6,0" />
                            <Button Grid.Column="2"
                                    Content="新建"
                                    Style="{StaticResource CompactButton}"
                                    Width="56"
                                    MinWidth="56"
                                    Margin="0,0,4,0"
                                    Command="{Binding AddAtCommandSetCommand}" />
                            <Button Grid.Column="3"
                                    Content="删除"
                                    Style="{StaticResource CompactDangerButton}"
                                    Width="56"
                                    MinWidth="56"
                                    Command="{Binding DeleteAtCommandSetCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ImportedAtCommands.Count, StringFormat=共 {0} 条}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,2,4" />
                        <WrapPanel Grid.Row="2">
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                    <Setter Property="Width" Value="58" />
                                    <Setter Property="MinWidth" Value="58" />
                                    <Setter Property="Padding" Value="6,3" />
                                    <Setter Property="Margin" Value="2,0,4,4" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="导入AT" Command="{Binding ImportAtFileCommand}" ToolTip="覆盖导入 AT 文件" />
                            <Button Content="追加AT" Command="{Binding AppendAtFileCommand}" ToolTip="追加 AT 文件" />
                            <Button Content="自定义" Command="{Binding CustomAtImportCommand}" ToolTip="手动输入命令，一行一条" />
                        </WrapPanel>
                    </Grid>
                    <ListBox ItemsSource="{Binding ImportedAtCommands}"
                             SelectedItem="{Binding SelectedAtCommand}"
                             FontFamily="Consolas"
                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                             SelectionChanged="ImportedAtCommandsListBox_SelectionChanged"
                             PreviewKeyDown="ImportedAtCommandsListBox_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="编辑"
                                          Command="{Binding PlacementTarget.Tag.EditImportedAtCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="删除"
                                          Command="{Binding PlacementTarget.Tag.RemoveImportedAtCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_PreviewMouseRightButtonDown" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TabControl x:Name="CommandTabs"
                    SelectedIndex="{Binding SelectedCommandPanelTabIndex}">
            <TabControl.Style>
                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="5,0,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommandPanelVerticalShape}" Value="True">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="单条命令">
                <Grid Margin="10"
                      TextElement.FontWeight="SemiBold">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Row="0"
                             Grid.Column="0"
                             MinWidth="260"
                             InputMethod.IsInputMethodEnabled="True"
                             Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              ItemsSource="{Binding LineEndingOptions}"
                              SelectedItem="{Binding SelectedLineEnding}" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="发送"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendCommand}" />
                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Top" Margin="0,8,0,0" Content="解析转义字符（\r、\n、\t、\\）" IsChecked="{Binding InterpretCommandEscapes}" ToolTip="默认开启；转义换行与后续数据在一次写入中发送。末尾仍追加右侧选择的换行符，选 None 可不追加。" />
                    <Grid Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="3"
                          HorizontalAlignment="Left"
                          Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="循环间隔(ms)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Margin="0,0,10,4" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Width="96"
                                 HorizontalAlignment="Left"
                                 Text="{Binding SingleCommandLoopIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="每轮单条发送之间的等待时间，单位 ms；0 表示不等待"
                                 Margin="4,0,4,4" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="循环次数"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right"
                                   Margin="0,0,10,0" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Width="96"
                                 HorizontalAlignment="Left"
                                 Text="{Binding SingleCommandLoopCount, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsSingleCommandLoopCountEnabled}"
                                 ToolTip="0 表示不循环，只执行一轮；大于 0 按指定次数执行。无限循环请使用右侧勾选框。" />
                        <Button Grid.Row="1"
                                Grid.Column="3"
                                Content="{Binding SingleCommandLoopActionText}"
                                Style="{StaticResource CompactButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,0"
                                Command="{Binding ToggleSingleCommandLoopCommand}" />
                        <CheckBox Grid.Row="1" Grid.Column="4" Content="无限循环" IsChecked="{Binding SingleCommandInfiniteLoop}"
                                  VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="勾选后持续运行，忽略次数；修改不会改变已经启动的任务。" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="命令组">
                <TabItem.HeaderTemplate>
                    <DataTemplate><TextBlock Text="{Binding DataContext.CommandGroups.Count, RelativeSource={RelativeSource AncestorType=TabControl}, StringFormat=命令组（{0}）}" /></DataTemplate>
                </TabItem.HeaderTemplate>
                <Grid DataContext="{Binding CommandPanel}" Margin="4,2">
                    <Grid.Resources>
                        <Style x:Key="CommandListButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
                            <Setter Property="Height" Value="22" />
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="MinWidth" Value="36" />
                            <Setter Property="Padding" Value="5,1" />
                        </Style>
                        <Style x:Key="CommandListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="1,0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                        <Style x:Key="StableCommandList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <!-- 保留滚动条栏宽，避免分类切换时各列左右移动；无溢出时仅隐藏滑块。 -->
                            <Style.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="Maximum" Value="0">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Style.Resources>
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        </Style>
                        <Style x:Key="CommandListGroupBox" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupBox">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Grid.RowSpan="2" Margin="0,8,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" />
                                            <Border HorizontalAlignment="Left" Margin="6,0,0,0" Padding="4,0" Background="{DynamicResource PanelBrush}">
                                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{DynamicResource MutedBrush}" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
                                            </Border>
                                            <ContentPresenter Grid.Row="1" Margin="4,2,4,2" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <WrapPanel Margin="0,0,0,0">
                        <Button Content="命令组设置" Style="{StaticResource CompactButton}" Command="{Binding CommandGroupSettingsCommand}" Margin="0,0,6,0" />
                        <Button Content="并行运行勾选组" Style="{StaticResource CompactButton}" Command="{Binding GroupScheduler.RunSelectedCommand}" Margin="0,0,6,0" />
                        <Button Content="停止组任务" Style="{StaticResource CompactButton}" Command="{Binding StopCurrentListGroupsCommand}" Margin="0" ToolTip="仅停止当前列表中的运行组；执行队列请使用“停止队列”。" />
                    </WrapPanel>
                    <TabControl x:Name="GroupListTabs" Grid.Column="1" ItemsSource="{Binding CommandGroupListOptions}" SelectedItem="{Binding SelectedCommandGroupList}"
                                BorderThickness="0" Padding="0" Margin="8,0,0,0" AutomationProperties.Name="命令组分类列表">
                        <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Header}" ToolTip="{Binding Name}" /></DataTemplate></TabControl.ItemTemplate>
                        <TabControl.ContentTemplate><DataTemplate><Grid /></DataTemplate></TabControl.ContentTemplate>
                    </TabControl></Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="{Binding CurrentListHeader}" Style="{StaticResource CommandListGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat=命令组列表 · {0}}" /></DataTemplate>
                            </GroupBox.HeaderTemplate>
                                <ListBox x:Name="CommandGroupsList" ItemsSource="{Binding VisibleCommandGroups}" SelectedItem="{Binding SelectedCommandGroup}"
                                         Tag="{Binding}" Style="{StaticResource StableCommandList}" ItemContainerStyle="{StaticResource CommandListItem}"
                                         PreviewMouseLeftButtonDown="CommandList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="CommandList_PreviewMouseRightButtonDown" PreviewKeyDown="CommandList_PreviewKeyDown"
                                         MouseDoubleClick="CommandList_EditGroupOnDoubleClick">
                                    <ListBox.ContextMenu><ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.CurrentListRemoveLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Delete" Command="{Binding PlacementTarget.Tag.RemoveCurrentListMemberCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu></ListBox.ContextMenu>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Height="24" Background="Transparent" ToolTip="双击非勾选区域编辑此命令组">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="1.9*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Margin="2,0,6,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelectedForRun}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                          AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" ToolTip="{Binding Summary}"
                                                       Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ExecutionStatus}" ToolTip="{Binding ExecutionStatus}"
                                                       FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="3" Content="运行" Style="{StaticResource CommandListButton}" ToolTip="按配置执行；0 次为不循环，只执行一轮；仅勾选“无限循环”时持续运行。循环间隔为 0 时不等待。"
                                                    Command="{Binding DataContext.GroupScheduler.RunGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,4,0" />
                                            <Button Grid.Column="4" Content="入队" Style="{StaticResource CommandListButton}" ToolTip="{Binding QueueAdmissionToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.GroupScheduler.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0" />
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                        </GroupBox>
                        <GroupBox Header="{Binding GroupScheduler.Queue.Count}" Grid.Column="2" Style="{StaticResource CommandListGroupBox}">
                            <GroupBox.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat=执行队列（{0}）}" /></DataTemplate>
                            </GroupBox.HeaderTemplate>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Content="执行队列" Style="{StaticResource CompactButton}" Command="{Binding GroupScheduler.RunQueueCommand}" Margin="0,0,4,0" ToolTip="当前工作区共用一个队列，可混合不同列表的命令组，切换列表不改变队列。按加入顺序执行，无限循环组不能入队。" />
                                        <Button Content="停止队列" Style="{StaticResource CompactButton}" Command="{Binding GroupScheduler.StopQueueCommand}" Margin="0,0,4,0" />
                                        <Button Content="清空" Style="{StaticResource CompactButton}" Command="{Binding GroupScheduler.ClearQueueCommand}" Margin="0,0,4,0" ToolTip="清空当前工作区执行队列，不删除命令组；队列运行时不可清空。" ToolTipService.ShowOnDisabled="True" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding GroupScheduler.QueueStatus}" ToolTip="{Binding GroupScheduler.QueueStatus}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox x:Name="CommandGroupQueueList" ItemsSource="{Binding GroupScheduler.Queue}" SelectedItem="{Binding GroupScheduler.SelectedQueueItem}"
                                         Tag="{Binding}" Style="{StaticResource StableCommandList}" ItemContainerStyle="{StaticResource CommandListItem}"
                                         PreviewMouseLeftButtonDown="CommandList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="CommandList_PreviewMouseRightButtonDown" PreviewKeyDown="CommandList_PreviewKeyDown">
                                    <ListBox.ContextMenu><ContextMenu>
                                        <MenuItem Header="删除" InputGestureText="Delete"
                                                  Command="{Binding PlacementTarget.Tag.GroupScheduler.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu></ListBox.ContextMenu>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Grid Height="24">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" FontWeight="Normal" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Ymodem">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding Ymodem}" Margin="10">
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="模式" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding CanEdit}" Width="140" Margin="0,0,12,0" AutomationProperties.Name="Ymodem 模式">
                                <ComboBoxItem Content="自定义 Ymodem" /><ComboBoxItem Content="标准 Ymodem" />
                            </ComboBox>
                            <WrapPanel x:Name="YmodemRuleOptions">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModeIndex}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <TextBlock Text="规则方案" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="Id" SelectedValue="{Binding SelectedProfileId}"
                                          IsEnabled="{Binding CanSelectProfile}" MinWidth="180" MaxWidth="300" Margin="0,0,8,0" AutomationProperties.Name="Ymodem 规则方案">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="规则设置" Command="{Binding RulesCommand}" Margin="0" />
                            </WrapPanel>
                        </WrapPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="导入固件" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                     InputMethod.IsInputMethodEnabled="True" AutomationProperties.Name="固件文件路径" ToolTip="选择非空 .bin 文件" />
                        </DockPanel>
                        <TextBlock Text="{Binding FileSizeText}" Margin="0,0,0,6" />
                        <TextBlock Text="复用左侧“目标窗口”勾选，仅支持本地串口。所有目标并行发送同一文件，分别显示结果；标准模式需设备手动进入接收状态。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="开始烧录" Command="{Binding StartCommand}" Margin="0,0,8,0" />
                            <Button Content="取消全部" Command="{Binding CancelCommand}" Margin="0" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding TargetProgress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <Button DockPanel.Dock="Right" Content="取消此窗口" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="12" Margin="0,0,0,5" AutomationProperties.Name="窗口固件传输进度" />
                                            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
        </Grid>
    </Grid>
</UserControl>

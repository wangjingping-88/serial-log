<Window x:Class="SerialLog.App.Views.PortInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="串口管理" Width="1080" Height="650" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="16">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="串口管理" FontSize="20" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center" />
            <CheckBox x:Name="NotificationToggle" Content="串口插拔时弹框提示" Checked="Notification_Changed" Unchecked="Notification_Changed"
                      Margin="0,0,14,0" VerticalAlignment="Center"
                      ToolTip="默认开启；关闭后继续监测并记录最近事件" />
            <Button Content="刷新" Click="Refresh_Click" Margin="0,0,6,0" />
            <Button x:Name="ImportButton" Content="导入旧配置…" Click="Import_Click" />
        </WrapPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
        <TabControl>
            <TabItem Header="端口清单">
                <DockPanel Background="{DynamicResource PanelBrush}" Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Label Target="{Binding ElementName=Search}" Content="搜索" VerticalAlignment="Center" />
                        <TextBox x:Name="Search" Width="218" MaxLength="200" Margin="0,0,12,0"
                                 TextChanged="Filter_Changed" InputMethod.IsInputMethodEnabled="True"
                                 ToolTip="支持 COM、别名、厂商、驱动、分组和工作区，也可输入 /COM(7|8)$/i" />
                        <Label Target="{Binding ElementName=GroupFilter}" Content="分组" VerticalAlignment="Center" />
                        <ComboBox x:Name="GroupFilter" Width="160" TextSearch.TextPath="Name"
                                  HorizontalContentAlignment="Stretch" SelectionChanged="GroupFilter_Changed" Margin="0,0,6,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="NewGroup" Content="新建…" Click="NewGroup_Click" Margin="0,0,6,0" />
                        <Button x:Name="EditGroup" Content="编辑…" Click="EditGroup_Click" Margin="0,0,6,0" />
                        <Button x:Name="DeleteGroup" Content="删除分组…" Click="DeleteGroup_Click" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="AliasButton" Content="编辑别名…" Click="EditAlias_Click" Margin="0,0,6,0" />
                        <Button x:Name="AssignGroup" Content="移至分组…" Click="AssignGroup_Click" Margin="0,0,6,0" />
                        <Button x:Name="Earlier" Content="上移" Click="Move_Click" Tag="-1" Margin="0,0,6,0" />
                        <Button x:Name="Later" Content="下移" Click="Move_Click" Tag="1" Margin="0,0,12,0" />
                        <Button x:Name="Locate" Content="定位窗口…" Click="Locate_Click" Margin="0,0,6,0" />
                        <Button x:Name="Add" Content="加入当前工作区" Click="Add_Click"
                                ToolTip="建立窗口并预填端口，需手动连接" />
                    </WrapPanel>
                    <DataGrid x:Name="Ports" AutomationProperties.Name="本机串口清单"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" SelectionChanged="Ports_SelectionChanged"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrushSoft}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="65" />
                            <DataGridTextColumn Header="别名" Binding="{Binding Alias}" Width="*" MinWidth="82" />
                            <DataGridTemplateColumn Header="分组" Width="*" MinWidth="78">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="7" Height="7" CornerRadius="2" Background="{Binding GroupColor}" Margin="4,0,5,0" />
                                            <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="设备" Binding="{Binding DeviceName}" Width="2*" MinWidth="100" />
                            <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="*" MinWidth="70" />
                            <DataGridTextColumn Header="驱动服务" Binding="{Binding DriverService}" Width="*" MinWidth="70" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="*" MinWidth="93" />
                            <DataGridTextColumn Header="工作区 / 窗口" Binding="{Binding Owner}" Width="2*" MinWidth="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="最近事件">
                <DockPanel Margin="6">
                    <Button DockPanel.Dock="Bottom" Content="清空事件" Click="Clear_Click" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    <ListBox x:Name="History" AutomationProperties.Name="最近 80 条串口插拔事件">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="90" Foreground="{DynamicResource MutedBrush}" />
                                    <TextBlock Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Window x:Class="SerialLog.App.FloatingCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SerialLog.App.Views"
        Title="命令区"
        Width="1180"
        Height="360"
        MinWidth="520"
        MinHeight="300"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="隐藏" Margin="4,0" Style="{StaticResource CompactButton}"
                            Command="{Binding ToggleCommandPanelVisibilityCommand}" ToolTip="隐藏命令区；通过视图菜单恢复" />
                    <Button DockPanel.Dock="Right"
                            Content="停靠"
                            Style="{StaticResource CompactButton}"
                            Command="{Binding RestoreCommandPanelCommand}"
                            ToolTip="恢复到原停靠位置" />
                    <TextBlock Text="命令区"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <views:CommandPanelView Grid.Row="1" />
        </Grid>
    </Border>
</Window>

<Window x:Class="SerialLog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:SerialLog.App.Behaviors"
        xmlns:controls="clr-namespace:SerialLog.App.Controls"
        xmlns:config="clr-namespace:SerialLog.Core.Configuration;assembly=SerialLog.Core"
        xmlns:converters="clr-namespace:SerialLog.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:views="clr-namespace:SerialLog.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Serial Log"
        Icon="Assets/AppIcon.ico"
        Height="950"
        MinHeight="760"
        Width="1500"
        MinWidth="1260"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        Deactivated="MainWindow_Deactivated"
        Background="#EEF2F6">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:WorkspaceScaleConverter x:Key="WorkspaceScaleConverter" />

<Style x:Key="TitleBarMenuToggle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="2,5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{Binding DataContext.ThemeSoftBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{Binding DataContext.ThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{Binding DataContext.ThemeSoftBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter TargetName="Chrome"
                                        Property="BorderBrush"
                                        Value="{Binding DataContext.ThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter Property="Foreground"
                                        Value="{Binding DataContext.ThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCaptionButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground"
                            Value="{Binding DataContext.ThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Setter Property="Background"
                            Value="{Binding DataContext.ThemeSoftBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Setter Property="BorderBrush"
                            Value="{Binding DataContext.ThemeColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButton"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarCaptionButton}" />

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,14,0">
                    <Image Source="Assets/BrandLogo.png" Width="20" Height="20" Margin="0,0,7,0" />
                    <TextBlock Text="Serial Log" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppBuildStatusText}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="7,1,0,0"
                               ToolTip="应用版本 / 多机协作协议版本" />
                </StackPanel>

                <ToggleButton x:Name="PageMenuToggle"
                              Grid.Column="1"
                              Content="页面"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=PageMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="PageMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=PageMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="210"
                            Margin="0,5,0,0"
                            Padding="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="页面管理" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="3,1,3,6" />
                            <Button Content="新增页" Command="{Binding AddPageCommand}" Style="{StaticResource CompactButton}" HorizontalAlignment="Stretch" />
                            <Button Content="删除当前页" Command="{Binding RemoveCurrentPageCommand}" Style="{StaticResource CompactDangerButton}" HorizontalAlignment="Stretch" Margin="3,5,3,0" ToolTip="仅当前页为空时可删除" />
                            <Separator Margin="3,8" />
                            <DockPanel Margin="3,0">
                                <Button DockPanel.Dock="Left"
                                        Content="上一页"
                                        Style="{StaticResource CompactButton}"
                                        AllowDrop="True"
                                        Drop="PreviousPageButton_Drop"
                                        Command="{Binding PreviousPageCommand}" />
                                <Button DockPanel.Dock="Right"
                                        Content="下一页"
                                        Style="{StaticResource CompactButton}"
                                        AllowDrop="True"
                                        Drop="NextPageButton_Drop"
                                        Command="{Binding NextPageCommand}" />
                                <TextBlock Text="{Binding PageLabel}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <Grid Margin="3,7,3,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="跳转到"
                                           Margin="10,0,0,0"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}" />
                                <ComboBox Grid.Column="1"
                                          Width="68"
                                          Margin="4,0"
                                          ItemsSource="{Binding PageNumbers}"
                                          SelectedItem="{Binding SelectedPageNumber, Mode=TwoWay}"
                                          ToolTip="选择要跳转的页面" />
                                <TextBlock Grid.Column="2"
                                           Text="页"
                                           Margin="4,0,0,0"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="CollaborationMenuToggle"
                              Grid.Column="2"
                              Content="协作"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=CollaborationMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="CollaborationMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=CollaborationMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="330"
                            Margin="0,5,0,0"
                            Padding="12"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="多机协作" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Text="模　　式" Margin="0,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      Margin="4"
                                      ItemsSource="{Binding WorkspaceModeOptions}"
                                      SelectedValuePath="Mode"
                                      SelectedValue="{Binding WorkspaceMode}"
                                      ToolTip="本地：单机使用；主机：监听其他 PC；从机：连接主机">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" HorizontalAlignment="Center" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="本机名称" Margin="0,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Margin="4,4"
                                     Text="{Binding LocalPcName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="主机端用它标识窗口来源" />
                            <TextBlock Grid.Row="3" Text="主机地址" Margin="0,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="1"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="从机模式填写主机 PC 的 IPv4" />
                            <TextBlock Grid.Row="4" Text="主机端口" Margin="0,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Margin="4"
                                     FontFamily="Consolas"
                                     Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="主机端口" />
                            <TextBlock Grid.Row="5" Text="启　　动" Margin="0,4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            <Button Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="4"
                                    HorizontalAlignment="Stretch"
                                    Content="{Binding ToggleCollaborationActionText}"
                                    Style="{StaticResource CompactButton}"
                                    Command="{Binding ToggleCollaborationCommand}" />
                        </Grid>
                    </Border>
                </Popup>

                <ToggleButton x:Name="ThemeMenuToggle"
                              Grid.Column="3"
                              Content="主题"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=ThemeMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="ThemeMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ThemeMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="190"
                            Margin="0,5,0,0"
                            Padding="10"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="主题色"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="3,1,3,6" />
                            <ComboBox HorizontalContentAlignment="Left"
                                      ItemsSource="{Binding ThemeColorOptions}"
                                      SelectedItem="{Binding SelectedThemeColorOption}"
                                      ToolTip="统一设置按钮高亮、日志窗口边框和滚动条颜色">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Background="{Binding Hex}"
                                                    BorderBrush="#FFFFFF"
                                                    BorderThickness="1" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Margin="3,7,3,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource CompactButton}"
                                    Click="ChooseCustomThemeColorButton_Click"
                                    ToolTip="打开 Windows 颜色选择器">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="12"
                                            Height="12"
                                            Margin="0,0,6,0"
                                            Background="{Binding ThemeColor}"
                                            BorderBrush="{StaticResource InputBorderBrush}"
                                            BorderThickness="1" />
                                    <TextBlock Text="自定义颜色…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="ViewMenuToggle"
                              Grid.Column="4"
                              Content="视图"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=ViewMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="ViewMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=ViewMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="356"
                            Margin="0,5,0,0"
                            Padding="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="命令区" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="3,1,3,6" />
                            <UniformGrid Columns="4">
                                <Button Content="停靠下方" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Bottom}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Bottom}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="停靠上方" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Top}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Top}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="停靠左侧" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Left}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Left}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="停靠右侧" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Right}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Right}">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </UniformGrid>
                            <Separator Margin="3,8" />
                            <Button Content="{Binding CommandPanelVisibilityActionText}" Style="{StaticResource CompactPrimaryButton}" Command="{Binding ToggleCommandPanelVisibilityCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="LogMenuToggle"
                              Grid.Column="5"
                              Content="日志"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=LogMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="LogMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=LogMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="410"
                            Margin="0,5,0,0"
                            Padding="10"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" /></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="日志目录" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="3,1,3,6" />
                            <TextBox FontFamily="Consolas" Text="{Binding LogRootDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="日志保存目录" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                <Button Content="浏览" Style="{StaticResource CompactButton}" Click="BrowseLogRootDirectoryButton_Click" />
                                <Button Content="新建会话" Style="{StaticResource CompactPrimaryButton}" Command="{Binding NewLogSessionCommand}" ToolTip="创建新的日志会话目录，后续日志写入该目录" />
                                <Button Content="当前会话日志"
                                        Style="{StaticResource CompactButton}"
                                        Click="OpenCurrentLogSessionButton_Click"
                                        ToolTip="在文件资源管理器中打开当前日志会话目录" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="HelpMenuToggle"
                              Grid.Column="6"
                              Content="帮助"
                              Style="{StaticResource TitleBarMenuToggle}"
                              Click="TitleBarMenuToggle_Click"
                              MouseEnter="TitleBarMenuToggle_MouseEnter"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              IsChecked="{Binding IsOpen, ElementName=HelpMenuPopup, Mode=TwoWay}" />
                <Popup x:Name="HelpMenuPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=HelpMenuToggle}"
                       StaysOpen="True"
                       AllowsTransparency="True">
                    <Border Width="220"
                            Margin="0,5,0,0"
                            Padding="8"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.16" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="帮助"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="3,1,3,6" />
                            <Button Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="OpenDocumentationButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="操作说明" />
                                </Grid>
                            </Button>
                            <Button Content="检查更新"
                                    Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,5,3,0"
                                    Click="CheckForUpdatesButton_Click" />
                            <Button Content="快捷键"
                                    Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="3,5,3,0"
                                    Click="OpenShortcutSettingsButton_Click" />
                            <Separator Margin="3,8" />
                            <Button Content="关于"
                                    Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="ShowAboutButton_Click" />
                        </StackPanel>
                    </Border>
                </Popup>

                <Button Grid.Column="7"
                        Content="{Binding ToggleAllConnectionsActionText}"
                        Command="{Binding ToggleAllConnectionsCommand}"
                        Margin="7,0,3,0"
                        Height="34"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CompactPrimaryButton}">
                            <Setter Property="MinWidth" Value="74" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasConnectedLocalSerialWindows}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#F3B8B4" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Grid.Column="8"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"
                           IsHitTestVisible="False" />

                <StackPanel Grid.Column="9"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="1,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="32"
                            Height="32"
                            Margin="2,0"
                            Padding="0"
                            Content="‹"
                            FontSize="17"
                            Style="{StaticResource CompactButton}"
                            Command="{Binding PreviousPageCommand}"
                            ToolTip="上一页（循环）" />
                    <ComboBox Width="48"
                              Height="30"
                              Padding="4,2"
                              ItemsSource="{Binding PageNumbers}"
                              SelectedItem="{Binding SelectedPageNumber, Mode=TwoWay}"
                              ToolTip="跳转到指定页面" />
                    <TextBlock Margin="4,0,2,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Text="{Binding PageCount, StringFormat=/ {0}}" />
                    <Button Width="32"
                            Height="32"
                            Margin="2,0"
                            Padding="0"
                            Content="›"
                            FontSize="17"
                            Style="{StaticResource CompactButton}"
                            Command="{Binding NextPageCommand}"
                            ToolTip="下一页（循环）" />
                </StackPanel>

                <Button Grid.Column="10"
                        Content="—"
                        Style="{StaticResource TitleBarCaptionButton}"
                        Click="MinimizeWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最小化" />
                <Button Grid.Column="11"
                        Content="□"
                        Style="{StaticResource TitleBarCaptionButton}"
                        Click="ToggleWindowStateButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="最大化或还原" />
                <Button Grid.Column="12"
                        Content="×"
                        Style="{StaticResource TitleBarCloseButton}"
                        Click="CloseWindowButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="关闭" />
            </Grid>
        </Border>

    <Grid x:Name="WorkspaceViewport"
          Grid.Row="1"
          ClipToBounds="True"
          Focusable="True"
          PreviewMouseDown="WorkspaceViewport_PreviewMouseDown">
    <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.Width>
            <MultiBinding Converter="{StaticResource WorkspaceScaleConverter}" ConverterParameter="Width">
                <Binding Path="ActualWidth" ElementName="WorkspaceViewport" />
                <Binding Path="ActualHeight" ElementName="WorkspaceViewport" />
            </MultiBinding>
        </Grid.Width>
        <Grid.Height>
            <MultiBinding Converter="{StaticResource WorkspaceScaleConverter}" ConverterParameter="Height">
                <Binding Path="ActualWidth" ElementName="WorkspaceViewport" />
                <Binding Path="ActualHeight" ElementName="WorkspaceViewport" />
            </MultiBinding>
        </Grid.Height>
        <Grid.LayoutTransform>
            <ScaleTransform>
                <ScaleTransform.ScaleX>
                    <MultiBinding Converter="{StaticResource WorkspaceScaleConverter}">
                        <Binding Path="ActualWidth" ElementName="WorkspaceViewport" />
                        <Binding Path="ActualHeight" ElementName="WorkspaceViewport" />
                    </MultiBinding>
                </ScaleTransform.ScaleX>
                <ScaleTransform.ScaleY>
                    <MultiBinding Converter="{StaticResource WorkspaceScaleConverter}">
                        <Binding Path="ActualWidth" ElementName="WorkspaceViewport" />
                        <Binding Path="ActualHeight" ElementName="WorkspaceViewport" />
                    </MultiBinding>
                </ScaleTransform.ScaleY>
            </ScaleTransform>
        </Grid.LayoutTransform>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="7" Padding="12,7">
            <Grid x:Name="TopToolbarViewport" ClipToBounds="True">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Serial Log"
                               FontSize="19"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Padding="0,1,0,0"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AppBuildStatusText}"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               ToolTip="应用版本 / 多机协作协议版本" />
                    <Button Content="新增页" Command="{Binding AddPageCommand}" />
                    <Button Content="删除页"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RemoveCurrentPageCommand}"
                            ToolTip="仅当前页为空时可删除" />
                    <Button Content="{Binding ToggleAllConnectionsActionText}"
                            Command="{Binding ToggleAllConnectionsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConnectedLocalSerialWindows}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="#F3B8B4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Margin="12,0,8,0"
                            Padding="7,4"
                            Background="#F8FBFE"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="多机协作"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <ComboBox Width="74"
                                      Margin="0,0,6,0"
                                      ItemsSource="{Binding WorkspaceModeOptions}"
                                      SelectedValuePath="Mode"
                                      SelectedValue="{Binding WorkspaceMode}"
                                      ToolTip="本地：单机使用；主机：监听其他 PC；客户端：连接主机">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Width="92"
                                     Margin="0,0,6,0"
                                     Text="{Binding LocalPcName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="本机名称，主机端用它标识窗口来源" />
                            <ComboBox x:Name="PcColorComboBox"
                                      Width="86"
                                      Margin="0,0,6,0"
                                      HorizontalContentAlignment="Left"
                                      ItemsSource="{Binding PcColorOptions}"
                                      SelectedItem="{Binding SelectedPcColorOption}"
                                      ToolTip="本机窗口颜色；自动会按本机名生成固定颜色">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                            <Border Width="12"
                                                    Height="12"
                                                    Margin="0,0,6,0"
                                                    Background="{Binding Hex}"
                                                    BorderBrush="#FFFFFF"
                                                    BorderThickness="1" />
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="主机"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center" />
                            <TextBox Width="118"
                                     Margin="0,0,6,0"
                                     FontFamily="Consolas"
                                     Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="主机模式会自动填本机 IPv4；客户端模式填写主机 PC 的 IPv4" />
                            <TextBlock Text="端口"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,4,0"
                                       VerticalAlignment="Center" />
                            <TextBox Width="58"
                                     Margin="0,0,6,0"
                                     FontFamily="Consolas"
                                     Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="主机端口" />
                            <Button Content="{Binding StartCollaborationActionText}"
                                    Style="{StaticResource CompactButton}"
                                    Command="{Binding StartCollaborationCommand}"
                                    ToolTip="按当前模式启动主机或连接主机" />
                            <Button Content="停止"
                                    Style="{StaticResource CompactDangerButton}"
                                    Command="{Binding StopCollaborationCommand}"
                                    ToolTip="停止协作连接" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Margin="8,0,8,0"
                            Padding="7,4"
                            Background="#F8FBFE"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="命令区"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <Button Content="下" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Bottom}" ToolTip="命令区停靠到底部">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Bottom}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="上" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Top}" ToolTip="命令区停靠到顶部">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Top}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="左" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Left}" ToolTip="命令区停靠到左侧">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Left}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="右" Command="{Binding SetCommandPanelDockCommand}" CommandParameter="{x:Static config:CommandPanelDock.Right}" ToolTip="命令区停靠到右侧">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CommandPanelDock}" Value="{x:Static config:CommandPanelDock.Right}">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding CommandPanelVisibilityActionText}"
                                    Command="{Binding ToggleCommandPanelVisibilityCommand}"
                                    ToolTip="隐藏命令区，仅查看日志；再次点击显示命令区">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
                                        <Setter Property="MinWidth" Value="42" />
                                        <Setter Property="Margin" Value="6,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommandPanelHidden}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Margin="6,0,0,0"
                            Padding="7,4"
                            Background="#F8FBFE"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="6"
                            VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志目录"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,8,0" />
                            <TextBox Grid.Column="1"
                                     MinWidth="80"
                                     FontFamily="Consolas"
                                     Text="{Binding LogRootDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2"
                                    Content="浏览"
                                    Margin="6,0,0,0"
                                    Padding="10,2"
                                    ToolTip="选择日志保存目录"
                                    Click="BrowseLogRootDirectoryButton_Click" />
                            <Button Grid.Column="3"
                                    Content="新建会话"
                                    Margin="6,0,0,0"
                                    Padding="10,2"
                                    Command="{Binding NewLogSessionCommand}"
                                    ToolTip="创建新的日志会话目录，后续日志写入该目录" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="上一页"
                                AllowDrop="True"
                                Drop="PreviousPageButton_Drop"
                                Command="{Binding PreviousPageCommand}"
                                ToolTip="点击翻页；拖动串口窗口到这里可移动到上一页" />
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="9,2" Margin="8,0">
                            <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                        <Button Content="下一页"
                                AllowDrop="True"
                                Drop="NextPageButton_Drop"
                                Command="{Binding NextPageCommand}"
                                ToolTip="点击翻页；拖动串口窗口到这里可移动到下一页" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="1" LastChildFill="True">
        <Border x:Name="CommandPanelHost"
                DockPanel.Dock="{Binding CommandPanelDockEdge}"
                Width="{Binding CommandPanelWidth}"
                Height="{Binding CommandPanelHeight}"
                Margin="{Binding CommandPanelMargin}"
                Visibility="{Binding CommandPanelVisibility}"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="CommandPanelHeader_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="CommandPanelHeader_PreviewMouseMove"
                        ToolTip="拖动到软件外部可浮动命令区">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="浮动"
                                Style="{StaticResource CompactButton}"
                                Command="{Binding FloatCommandPanelCommand}"
                                ToolTip="将命令区浮动成独立窗口" />
                        <TextBlock Text="命令区"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <views:CommandPanelView Grid.Row="1" />
            </Grid>
        </Border>

        <Grid>
        <ItemsControl ItemsSource="{Binding CurrentPageWindows}" Margin="2,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:SerialWindowGridPanel Rows="{Binding SerialGridRows}" Columns="{Binding SerialGridColumns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                    <Border Margin="4"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{Binding Window.OwnerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            AllowDrop="True"
                            ToolTip="拖动空白区域可调整窗口顺序"
                            PreviewMouseLeftButtonDown="SerialWindowCard_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="SerialWindowCard_PreviewMouseMove"
                            Drop="SerialWindowCard_Drop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{Binding Window.OwnerBorderBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsAddSlot}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel DataContext="{Binding Window}">
                            <Border DockPanel.Dock="Top"
                                    Background="{Binding OwnerHeaderBrush}"
                                    BorderBrush="{Binding OwnerBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0"
                                             Margin="0,0,6,0"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelectedForSend}"
                                                      IsEnabled="{Binding CanSendCommands}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="参与单条命令发送" />
                                            <TextBox Width="96"
                                                     Margin="3,0"
                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TitleTextBox}" />
                                            <ComboBox Width="80"
                                                      Margin="2,0"
                                                      ItemsSource="{Binding AvailablePorts}"
                                                      SelectedItem="{Binding PortName}"
                                                      IsEnabled="{Binding IsLocalSerial}"
                                                      ToolTip="端口" />
                                            <ComboBox Width="76"
                                                      Margin="2,0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      ItemsSource="{Binding BaudRateOptions}"
                                                      Text="{Binding BaudRateText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsLocalSerial}"
                                                      ToolTip="波特率" />
                                            <Button Content="刷新"
                                                    MinWidth="42"
                                                    Style="{StaticResource CompactButton}"
                                                    Command="{Binding RefreshPortsCommand}"
                                                    IsEnabled="{Binding IsLocalSerial}"
                                                    ToolTip="刷新端口" />
                                            <Button Content="{Binding ConnectionActionText}"
                                                    MinWidth="42"
                                                    Style="{StaticResource ToggleConnectionButton}"
                                                    Command="{Binding ToggleConnectionCommand}"
                                                    IsEnabled="{Binding IsLocalSerial}"
                                                    ToolTip="远端窗口的连接状态由远端电脑控制" />
                                            <Button Content="清空"
                                                    MinWidth="42"
                                                    Style="{StaticResource CompactButton}"
                                                    Command="{Binding ClearCommand}"
                                                    ToolTip="清空日志" />
                                            <Button Content="删除"
                                                    MinWidth="42"
                                                    Style="{StaticResource CompactDangerButton}"
                                                    Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="删除窗口" />
                                            <Button Content="{Binding DataContext.ExpandActionText, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                    MinWidth="42"
                                                    Style="{StaticResource CompactButton}"
                                                    Command="{Binding DataContext.ToggleWindowExpansionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                    ToolTip="当前页下方有空槽时，纵向放大或还原窗口" />
                                            <CheckBox Margin="6,0,0,0"
                                                      IsChecked="{Binding AutoSaveEnabled}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding AutoSaveToggleVisibility}"
                                                      ToolTip="{Binding AutoSaveToolTip}" />
                                        </StackPanel>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 Fill="{Binding ConnectionIndicatorBrush}"
                                                 Stroke="#FFFFFF"
                                                 StrokeThickness="1"
                                                 HorizontalAlignment="Right"
                                                 Margin="0,1,0,6"
                                                 ToolTip="{Binding StatusText}" />
                                        <TextBlock Text="{Binding LineCount}"
                                                   Width="44"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   ToolTip="接收行数" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox ItemsSource="{Binding Lines}"
                                     behaviors:ListBoxAutoScroll.IsEnabled="True"
                                     behaviors:ListBoxAutoScroll.IsPaused="{Binding IsLogAutoScrollPaused, Mode=TwoWay}"
                                     SelectionMode="Extended"
                                     Background="#FFFFFF"
                                     BorderBrush="{StaticResource BorderBrushSoft}"
                                     Foreground="#111827"
                                     Margin="8"
                                     FontFamily="Consolas"
                                     GotKeyboardFocus="LogListBox_GotKeyboardFocus"
                                     PreviewKeyDown="LogListBox_PreviewKeyDown"
                                     PreviewMouseRightButtonDown="LogListBox_PreviewMouseRightButtonDown"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource SlimScrollBarStyle}">
                                        <Setter Property="Foreground" Value="{Binding DataContext.OwnerBorderBrush, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.FontSize>
                                    <MultiBinding Converter="{StaticResource WorkspaceScaleConverter}"
                                                  ConverterParameter="LogFontSize">
                                        <Binding Path="ActualWidth" ElementName="WorkspaceViewport" />
                                        <Binding Path="ActualHeight" ElementName="WorkspaceViewport" />
                                    </MultiBinding>
                                </ListBox.FontSize>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="复制选中日志"
                                                  Click="CopySelectedLogMenuItem_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="#111827" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                            <Setter Property="Background" Value="#FDE68A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ItemsControl ItemsSource="{Binding DisplaySegments}"
                                                          Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding EffectiveForeground}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                   TextWrapping="NoWrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Button Content="+"
                            Width="72"
                            Height="72"
                            Focusable="False"
                            FontSize="36"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.AddWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Background" Value="#F8FBFE" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAddSlot}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
        </DockPanel>

    </Grid>
    </Grid>
    </Grid>
    </Grid>
</Window>
